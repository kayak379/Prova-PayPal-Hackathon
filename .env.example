OPENROUTER_API_KEY=
CHANNEL3_API_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID of the sandbox webhook registered for /api/paypal/webhook (not a secret).
PAYPAL_WEBHOOK_ID=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Server-only PostgreSQL + shared demo login
DATABASE_URL=
DEMO_EMAIL=ops@harborrelief.org
DEMO_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional canonical URL for a custom domain; Render otherwise uses RENDER_EXTERNAL_URL.
# APP_URL=https://your-domain.example

# Optional encrypted, already-approved sandbox wallet. Imported once during db:setup.
PAYPAL_DEFAULT_VAULT_WALLET=

# Server-only bearer secret for POST /api/disasters/webhook. Never use NEXT_PUBLIC_.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DISASTER_WEBHOOK_SECRET=

# Optional dedicated Ed25519 signing key, base64 PKCS#8 DER or PEM.
# Use the same key in the web service, disaster worker and reconciliation jobs.
# See docs/evidence-chain.md for generation, trusted verification and rotation.
EVIDENCE_SIGNING_PRIVATE_KEY=
